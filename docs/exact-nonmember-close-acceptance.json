{
  "schema_version": 1,
  "bead": "bd-7c1f0f",
  "scope": "source-only; isolated fake provider and local test repositories",
  "requirements": [
    {
      "id": "close.exact",
      "contract": "One confirmed exact source/base/main close; CLI and MCP share typed handlers.",
      "tests": ["exact_close_persists_intent_and_replays_without_another_write", "actual_cli_closes_once_and_local_status_matches_mcp", "close_tools_publish_the_same_typed_bounded_contract"]
    },
    {
      "id": "close.membership",
      "contract": "Active, parked, force-owned and native membership or incomplete evidence cannot become non-member authority.",
      "tests": ["active_parked_force_and_native_members_refuse_without_intent", "drift_admission_race_fence_loss_and_unknown_inventory_send_no_close", "close_subject_requires_explicit_complete_label_evidence_without_check_rollups", "open_native_membership_refuses_but_closed_stack_history_is_not_membership"]
    },
    {
      "id": "close.representation",
      "contract": "Provider proof, not caller assertions, establishes representation on exact main.",
      "tests": ["representation_identity_and_permission_are_not_caller_assertions", "ancestor_representation_allows_different_trees_when_ancestry_is_proven", "close_commit_identity_requires_explicit_matching_provider_sha"]
    },
    {
      "id": "close.fence",
      "contract": "Use the existing production writer policy and mark the sole state patch as a provider write.",
      "tests": ["writer_policy_refuses_before_provider_or_intent", "close_adapter_marks_only_the_exact_state_patch_as_a_write", "close_adapter_cannot_execute_past_a_lost_fence", "post_write_drift_remains_indeterminate_and_never_reopens"]
    },
    {
      "id": "close.journal",
      "contract": "Private flushed intent survives process/linked-worktree boundaries; persistence failure never licenses a close.",
      "tests": ["private_atomic_receipt_survives_reload_and_linked_worktree", "failed_initial_persistence_never_reaches_the_provider", "durable_intent_without_an_http_attempt_is_never_replayed"]
    },
    {
      "id": "close.retry",
      "contract": "Same-key retries reconcile after intent and reject changed custody or policy identity.",
      "tests": ["accepted_response_and_readback_loss_survive_retry", "process_restart_reconciles_a_lost_close_response_without_replay", "changed_retry_identity_or_policy_is_refused_before_provider_access", "intent_without_observed_effect_never_reissues_close", "unavailable_preflight_can_resume_same_request_without_prior_close"]
    },
    {
      "id": "close.external",
      "contract": "External completion and uncertain attribution do not become fabricated close success.",
      "tests": ["external_completion_does_not_create_a_write_intent", "accepted_response_loss_reconciles_in_place_without_false_attribution"]
    },
    {
      "id": "close.bounds",
      "contract": "Explicit confirmation, bounded safe keys/identities and documented non-atomic/cross-host limits.",
      "tests": ["input_requires_confirmation_and_safe_bound_identities", "close_contract_inventory_is_backed_by_tests_and_states_fence_limits"]
    }
  ]
}
